# Data — never commit raw mass spec files (exceptions for scaffold files)
data/*
!data/.gitkeep
!data/README.md

# Results — generated outputs; reproducible from data + code
results/*
!results/README.md
!results/standard/
!results/standard/.gitkeep
!results/r_comparable/
!results/r_comparable/.gitkeep

# Python byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.pyo

# Distribution / packaging
*.egg-info/
dist/
build/
.eggs/

# Virtual environments
.venv/
venv/
env/
ENV/

# Jupyter
.ipynb_checkpoints/
*.ipynb

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon

# Editor
.vscode/
.idea/
*.swp
*.swo
*~

# Test / coverage
.pytest_cache/
.coverage
htmlcov/

# Logs
*.log

# >>> consolidate_data: local real datasets — DO NOT COMMIT >>>
# Private experimental data mapped by consolidate_data.py — never commit.
/data/experiment_c
/data/experiment_d
/data/experiment_a
/data/experiment_b
# Keep the synthetic demo dataset tracked even if data/* is ignored above:
!/data/sample_experiment/
# <<< consolidate_data <<<
